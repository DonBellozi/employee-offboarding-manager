APP_NAME=Управление жизненным циклом учетных записей
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_BASE_URL=https://accounts.example.local
APP_TIMEZONE=Asia/Almaty
DATABASE_URL=sqlite:///./data/app.db
SESSION_COOKIE_NAME=employee_offboarding_manager_session

# Первый локальный оператор. После первого запуска пароль лучше удалить из .env.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!123

# local | hybrid | ad
AUTH_MODE=hybrid
AD_LOGIN_ENABLED=false
AD_ALLOWED_GROUP_DN=

# Active Directory. Установка пароля требует защищенного LDAP.
AD_SERVER=dc01.example.local
AD_PORT=636
AD_USE_SSL=true
AD_VERIFY_TLS=true
AD_CA_CERT_FILE=/run/secrets/ad-ca.pem
AD_DOMAIN=EXAMPLE
AD_BASE_DN=DC=example,DC=local
AD_USERS_OU=OU=Users,DC=example,DC=local
AD_BIND_DN=CN=svc-provisioner,OU=Service Accounts,DC=example,DC=local
AD_BIND_PASSWORD=
AD_UPN_SUFFIX=example.local
AD_FORCE_CHANGE_AT_FIRST_LOGON=true
# Несколько DN разделять точкой с запятой.
AD_DEFAULT_GROUP_DNS=

# Zimbra: ssh_zmprov | disabled
ZIMBRA_BACKEND=ssh_zmprov
ZIMBRA_SSH_HOST=mail.example.local
ZIMBRA_SSH_PORT=22
ZIMBRA_SSH_USER=provisioner
# key | password | auto
ZIMBRA_SSH_AUTH=key
ZIMBRA_SSH_PRIVATE_KEY=/run/secrets/zimbra_ssh_key
# Для режима password задайте одно из двух значений. Файл предпочтительнее переменной.
ZIMBRA_SSH_PASSWORD=
ZIMBRA_SSH_PASSWORD_FILE=
ZIMBRA_SSH_KNOWN_HOSTS=/app/known_hosts
ZIMBRA_DOMAINS=example.ru,example.com
# separate – оператор выбирает домен; primary_alias – первый домен основной, остальные алиасы
ZIMBRA_DOMAIN_MODE=separate
ZIMBRA_PRIMARY_DOMAIN=example.ru
ZIMBRA_CREATE_ALIASES=true
ZIMBRA_COS_ID=
# Одновременных почтовых ящиков при проверке политик хранения: 1–8.
ZIMBRA_MAIL_CLEANUP_WORKERS=4

# Отправка реквизитов
SMTP_HOST=mail.example.local
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=provisioner@example.ru
SMTP_PASSWORD=
SMTP_FROM=provisioner@example.ru
SMTP_TIMEOUT_SECONDS=20
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=2

# Правила паролей
MAIL_PASSWORD_LENGTH=16
MAIL_PASSWORD_SPECIALS="!@#$%&?"
AD_PASSWORD_MIN_LENGTH=8
AD_PASSWORD_MAX_LENGTH=12
AD_PASSWORD_SPECIALS="!@#$%&?"

ROLLBACK_AD_ON_ZIMBRA_FAILURE=false

# Synology DSM – первый этап только чтение и сверка.
# known_hosts может содержать ключи и Zimbra, и Synology одновременно.
SYNOLOGY_ENABLED=false
SYNOLOGY_SSH_HOST=nas.example.local
SYNOLOGY_SSH_PORT=22
SYNOLOGY_SSH_USER=provisioner
SYNOLOGY_SSH_AUTH=auto
SYNOLOGY_SSH_PRIVATE_KEY=/run/secrets/synology_ssh_key
SYNOLOGY_SSH_PASSWORD=
SYNOLOGY_SSH_PASSWORD_FILE=
SYNOLOGY_SSH_KNOWN_HOSTS=/app/known_hosts
SYNOLOGY_SSH_USE_SUDO=true
SYNOLOGY_SYNOUSER_COMMAND=synouser
SYNOLOGY_CONNECT_TIMEOUT_SECONDS=10
SYNOLOGY_COMMAND_TIMEOUT_SECONDS=20
